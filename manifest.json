{
  "schemaVersion": 1,
  "id": "sehl.omarcal",
  "name": "Omarcal",
  "version": "0.1.0",
  "author": "Benjamin Sehl",
  "license": "MIT",
  "homepage": "https://github.com/benjaminsehl/omarcal",
  "repository": "https://github.com/benjaminsehl/omarcal",
  "description": "The clock, made useful: what's next on your Google Calendar, one key to join the call, one to start a new Meet.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "omarchy": { "clonedFrom": "omarchy.clock" },
  "barWidget": {
    "displayName": "Omarcal",
    "description": "Time, the next meeting, and a panel to join or start calls (Google Calendar)",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "HH:mm",
      "barNext": "title",
      "barLookaheadMinutes": 60,
      "barTitleLength": 24,
      "soonMinutes": 5,
      "handoffMinutes": 5,
      "days": 3,
      "maxEvents": 12,
      "calendars": "",
      "showDeclined": false,
      "showPast": false,
      "refreshMinutes": 5,
      "notifyMinutesBefore": 1,
      "newMeeting": "event",
      "newMeetingTitle": "Meet",
      "newMeetingMinutes": 30,
      "openWith": "browser",
      "closeOnJoin": true
    },
    "schema": [
      { "key": "format", "type": "string", "label": "Clock format (Qt, e.g. h:mm AP or HH:mm)", "defaultValue": "HH:mm" },
      { "key": "barNext", "type": "enum", "label": "Next meeting in the bar", "options": ["title", "countdown", "off"], "defaultValue": "title" },
      { "key": "barLookaheadMinutes", "type": "integer", "label": "Show it in the bar this many minutes ahead", "min": 0, "max": 720, "step": 5, "defaultValue": 60 },
      { "key": "barTitleLength", "type": "integer", "label": "Longest title in the bar (characters)", "min": 4, "max": 80, "step": 1, "defaultValue": 24 },
      { "key": "soonMinutes", "type": "integer", "label": "Signal colour this many minutes before a meeting", "min": 0, "max": 30, "step": 1, "defaultValue": 5 },
      { "key": "handoffMinutes", "type": "integer", "label": "Switch to the next meeting this many minutes before it starts", "min": 0, "max": 30, "step": 1, "defaultValue": 5 },
      { "key": "days", "type": "integer", "label": "Days to show", "min": 1, "max": 14, "step": 1, "defaultValue": 3 },
      { "key": "maxEvents", "type": "integer", "label": "Most meetings to list", "min": 1, "max": 50, "step": 1, "defaultValue": 12 },
      { "key": "calendars", "type": "string", "label": "Calendar IDs, comma-separated (blank: those shown in Google Calendar)", "defaultValue": "" },
      { "key": "showDeclined", "type": "boolean", "label": "Show declined meetings", "defaultValue": false },
      { "key": "showPast", "type": "boolean", "label": "Show meetings that have ended", "defaultValue": false },
      { "key": "refreshMinutes", "type": "integer", "label": "Refresh every (minutes)", "min": 1, "max": 60, "step": 1, "defaultValue": 5 },
      { "key": "notifyMinutesBefore", "type": "integer", "label": "Notify this many minutes before (-1: never)", "min": -1, "max": 30, "step": 1, "defaultValue": 1 },
      { "key": "newMeeting", "type": "enum", "label": "New meeting", "options": ["event", "instant"], "defaultValue": "event" },
      { "key": "newMeetingTitle", "type": "string", "label": "New meeting title", "defaultValue": "Meet" },
      { "key": "newMeetingMinutes", "type": "integer", "label": "New meeting length (minutes)", "min": 5, "max": 240, "step": 5, "defaultValue": 30 },
      { "key": "openWith", "type": "enum", "label": "Open calls in", "options": ["browser", "webapp"], "defaultValue": "browser" },
      { "key": "closeOnJoin", "type": "boolean", "label": "Close the panel when joining", "defaultValue": true }
    ]
  }
}
